<Window x:Class="NarakaLatency.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Naraka Latency Controller" Width="760" Height="710"
        MinWidth="700" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="全局网络延迟" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,12" Foreground="#526077"
                           Text="对整台电脑的普通互联网 TCP/UDP 流量增加固定延迟"/>
                <Border Background="#FFF4D6" Padding="10" CornerRadius="5"
                        Visibility="{Binding AdministratorWarningVisibility}">
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center" Text="该程序需要管理员权限才能加载网络过滤驱动。"/>
                        <Button DockPanel.Dock="Right" Content="以管理员身份重新启动"
                                Command="{Binding RelaunchElevatedCommand}"/>
                    </DockPanel>
                </Border>
                <TextBlock Margin="0,10,0,4" FontSize="16" FontWeight="SemiBold"
                           Text="{Binding StateDisplay}"/>
                <TextBlock Foreground="#526077" Text="{Binding HotkeyStatus}" TextWrapping="Wrap"/>
                <TextBlock Foreground="#B42318" Text="{Binding ErrorText}" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Inbound" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="服务器 → 本机" Foreground="#68758B"/>
                        <CheckBox Content="启用" IsChecked="{Binding InboundEnabled}"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="5" VerticalAlignment="Center" Text="ms"/>
                            <TextBox Text="{Binding InboundDelayMs, UpdateSourceTrigger=LostFocus, StringFormat=F1}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding InboundDelayMs}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Outbound" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="本机 → 服务器" Foreground="#68758B"/>
                        <CheckBox Content="启用" IsChecked="{Binding OutboundEnabled}"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="5" VerticalAlignment="Center" Text="ms"/>
                            <TextBox Text="{Binding OutboundDelayMs, UpdateSourceTrigger=LostFocus, StringFormat=F1}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding OutboundDelayMs}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <CheckBox Content="上下行联动（仅同步延迟数值）" IsChecked="{Binding LinkDirections}"/>
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Margin="4,11,8,0" Text="附加 RTT 预设："/>
                    <Button Content="10 ms" Command="{Binding ApplyPresetCommand}" CommandParameter="10"/>
                    <Button Content="15 ms" Command="{Binding ApplyPresetCommand}" CommandParameter="15"/>
                    <Button Content="20 ms" Command="{Binding ApplyPresetCommand}" CommandParameter="20"/>
                    <Button Content="25 ms" Command="{Binding ApplyPresetCommand}" CommandParameter="25"/>
                    <Button Content="30 ms" Command="{Binding ApplyPresetCommand}" CommandParameter="30"/>
                </WrapPanel>
                <TextBlock Margin="4,3" Foreground="#526077"
                           Text="最终 RTT 约等于基础 RTT + Inbound 延迟 + Outbound 延迟。"/>
            </StackPanel>

            <Border Grid.Row="3" Margin="0,12,0,0" Background="White" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="我的预设" FontSize="16" FontWeight="SemiBold"/>
                    <ComboBox Margin="0,7,0,0" ItemsSource="{Binding SavedPresets}"
                              SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Summary"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,6,6,0" Text="名称："/>
                        <TextBox Width="165" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Margin="8,0,0,0" Content="保存 / 覆盖当前设置"
                                Command="{Binding SaveCurrentPresetCommand}"/>
                        <Button Margin="8,0,0,0" Content="应用所选"
                                Command="{Binding ApplySavedPresetCommand}"/>
                        <Button Margin="8,0,0,0" Content="删除所选"
                                Command="{Binding DeleteSavedPresetCommand}"/>
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0" Foreground="#526077" TextWrapping="Wrap"
                               Text="{Binding PresetStatus}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="开始" Command="{Binding StartCommand}" Background="#3B82F6" Foreground="White"/>
                <Button Content="停止并安全放行" Command="{Binding StopCommand}"/>
                <Button Content="重置统计" Command="{Binding ResetMetricsCommand}"/>
                <CheckBox Margin="16,4,4,4" Content="启用调试 CSV（可能产生较大文件）"
                          IsChecked="{Binding CsvEnabled}"/>
            </StackPanel>

            <Border Grid.Row="5" Margin="0,12,0,0" Background="White" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="当前队列" Foreground="#68758B"/><TextBlock FontSize="18" Text="{Binding QueueDepth}"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="P95 调度误差" Foreground="#68758B"/><TextBlock FontSize="18" Text="{Binding P95ErrorDisplay}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="P99 调度误差" Foreground="#68758B"/><TextBlock FontSize="18" Text="{Binding P99ErrorDisplay}"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="发送失败" Foreground="#68758B"/><TextBlock FontSize="18" Text="{Binding SendFailures}"/></StackPanel>
                </Grid>
            </Border>

            <Expander Grid.Row="6" Margin="0,12,0,20" Header="高级信息" IsExpanded="{Binding AdvancedPanelExpanded}">
                <Border Background="White" Padding="12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding AdvancedMetricsText}" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="打开日志目录" Command="{Binding OpenLogDirectoryCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </ScrollViewer>
</Window>
